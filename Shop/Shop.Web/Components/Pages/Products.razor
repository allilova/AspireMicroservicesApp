@page "/products"
@inject CatalogApiClient Catalog
@inject CartService Cart
@inject ISnackbar Snackbar

<PageTitle>Продукти</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Продукти</MudText>

<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    <MudTextField @bind-Value="search" Label="Търсене по име" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="LoadAsync"
                  Style="max-width:320px" />

    <MudChip T="string" Color="Color.Primary"
             Variant="@(category == "" ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => SelectCategoryAsync(string.Empty))">Всички</MudChip>
    @foreach (var c in categories)
    {
        var current = c;
        <MudChip T="string" Color="Color.Primary"
                 Variant="@(category == current ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => SelectCategoryAsync(current))">@current</MudChip>
    }
</MudStack>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @error
        <MudButton Size="Size.Small" OnClick="RetryAsync" Class="ml-4">Опитай пак</MudButton>
    </MudAlert>
}
else if (products is null)
{
    <MudGrid>
        @for (var i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Animation="Animation.Wave" />
            </MudItem>
        }
    </MudGrid>
}
else if (products.Count == 0)
{
    <MudText>Няма намерени продукти.</MudText>
}
else
{
    <MudGrid>
        @foreach (var p in products)
        {
            <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex">
                <MudCard Class="product-card">
                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                    {
                        <MudCardMedia Image="@p.ImageUrl" Height="160" />
                    }
                    else
                    {
                        <div class="product-hero" style="background:@GradientFor(p.Category)">
                            <MudIcon Icon="@IconFor(p.Category)" Style="font-size:4rem;color:white;opacity:.9" />
                        </div>
                    }
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Primary">@p.Category</MudText>
                        <MudText Typo="Typo.h6">@p.Name</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@p.Description</MudText>
                    </MudCardContent>
                    <MudCardActions Class="px-4 pb-4 d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.h6">@p.Price.ToString("N2") €</MudText>
                            @if (p.Stock <= 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">Изчерпан</MudChip>
                            }
                            else if (p.Stock <= 5)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Остават @p.Stock</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Налични: @p.Stock</MudChip>
                            }
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                   Disabled="@(p.Stock <= 0)" OnClick="@(() => AddToCart(p))">
                            Добави
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private static readonly string[] Gradients =
    [
        "linear-gradient(135deg,#667eea,#764ba2)",
        "linear-gradient(135deg,#11998e,#38ef7d)",
        "linear-gradient(135deg,#f7971e,#ffd200)",
        "linear-gradient(135deg,#ee0979,#ff6a00)",
        "linear-gradient(135deg,#2193b0,#6dd5ed)"
    ];

    private List<ProductDto>? products;
    private List<string> categories = [];
    private string search = "";
    private string category = "";
    private string? error;

    private static string GradientFor(string cat) => Gradients[cat.Sum(ch => ch) % Gradients.Length];

    private static string IconFor(string cat) => cat switch
    {
        "Компютри" => Icons.Material.Filled.Computer,
        "Аксесоари" => Icons.Material.Filled.Headphones,
        _ => Icons.Material.Filled.Inventory2
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Catalog.GetProductsAsync();
            categories = all.Select(p => p.Category).Distinct().OrderBy(c => c).ToList();
            products = all;
        }
        catch (HttpRequestException)
        {
            error = "Каталогът не е достъпен. Опитайте по-късно.";
        }
    }

    private async Task RetryAsync()
    {
        error = null;
        await OnInitializedAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            error = null;
            products = await Catalog.GetProductsAsync(search, category);
        }
        catch (HttpRequestException)
        {
            error = "Каталогът не е достъпен. Опитайте по-късно.";
        }
    }

    private async Task SelectCategoryAsync(string c)
    {
        category = c;
        await LoadAsync();
    }

    private void AddToCart(ProductDto p)
    {
        if (Cart.Add(p))
            Snackbar.Add($"„{p.Name}“ е добавен в количката", Severity.Success);
        else
            Snackbar.Add("Достигнахте наличното количество", Severity.Warning);
    }
}