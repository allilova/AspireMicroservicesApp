@page "/cart"
@inject CartService CartState
@inject OrdersApiClient OrdersClient
@inject ISnackbar Snackbar

<PageTitle>Количка</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Количка</MudText>
    @if (CartState.Count > 0 && createdOrder is null)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-3">@CartState.Count бр.</MudChip>
    }
</div>

@if (createdOrder is not null)
{
    <MudPaper Class="pa-10 text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:5rem" />
        <MudText Typo="Typo.h4" Class="mt-2">Благодарим за поръчката!</MudText>
        <MudText Class="mud-text-secondary mt-1">
            Поръчка #@ShortId(createdOrder.Id) · Общо @createdOrder.Total.ToString("N2") €
        </MudText>
        <div class="mt-6">
            <MudButton Href="orders" Variant="Variant.Filled" Color="Color.Primary" Class="mr-2">Моите поръчки</MudButton>
            <MudButton Href="products" Variant="Variant.Outlined">Продължи пазаруването</MudButton>
        </div>
    </MudPaper>
}
else if (CartState.Lines.Count == 0)
{
    <MudPaper Class="pa-10 text-center">
        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Style="font-size:4rem" Class="mud-text-secondary" />
        <MudText Typo="Typo.h6" Class="mt-2">Количката е празна</MudText>
        <MudText Class="mud-text-secondary">Разгледай продуктите и добави нещо, което ти харесва.</MudText>
        <MudButton Href="products" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Към продуктите</MudButton>
    </MudPaper>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="8">
            @foreach (var line in CartState.Lines.ToList())
            {
                <MudPaper Class="cart-line pa-3 mb-3" Elevation="1">
                    @if (!string.IsNullOrWhiteSpace(line.Product.ImageUrl))
                    {
                        <img class="cart-thumb" src="@line.Product.ImageUrl" alt="@line.Product.Name" />
                    }
                    else
                    {
                        <div class="cart-thumb" style="background:@ProductVisuals.GradientFor(line.Product.Category)">
                            <MudIcon Icon="@ProductVisuals.IconFor(line.Product.Category)" Style="color:white" />
                        </div>
                    }

                    <div class="cart-info">
                        <MudText Typo="Typo.subtitle1">@line.Product.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @line.Product.Category · @line.Product.Price.ToString("N2") € за бр.
                        </MudText>
                    </div>

                    <div class="qty">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                       OnClick="() => CartState.Decrease(line.Product.Id)" />
                        <span class="qty-value">@line.Quantity</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       OnClick="() => AddOne(line)" />
                    </div>

                    <MudText Typo="Typo.h6" Class="cart-sum">@((line.Product.Price * line.Quantity).ToString("N2")) €</MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                   OnClick="() => CartState.Remove(line.Product.Id)" />
                </MudPaper>
            }
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="summary-card pa-5" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Обобщение</MudText>
                <div class="d-flex justify-space-between mb-1">
                    <MudText>Артикули</MudText>
                    <MudText>@CartState.Count</MudText>
                </div>
                <MudDivider Class="my-3" />
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6">Общо</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">@CartState.Total.ToString("N2") €</MudText>
                </div>

                <MudTextField @bind-Value="customerName" Label="Вашето име" Variant="Variant.Outlined" Class="mb-4"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                           Disabled="busy" OnClick="CheckoutAsync">
                    @if (busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Поръчай
                </MudButton>
                <MudButton Href="products" Variant="Variant.Text" FullWidth="true" Class="mt-2">Продължи пазаруването</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@error</MudAlert>
}

@code {
    private string customerName = "";
    private string? error;
    private bool busy;
    private OrderDto? createdOrder;

    private static string ShortId(string id) => id.Length > 6 ? id[^6..].ToUpperInvariant() : id;

    private void AddOne(CartLine line)
    {
        if (!CartState.Add(line.Product))
            Snackbar.Add("Достигнахте наличното количество", Severity.Warning);
    }

    private async Task CheckoutAsync()
    {
        error = null;
        createdOrder = null;

        if (string.IsNullOrWhiteSpace(customerName))
        {
            error = "Въведете име.";
            return;
        }

        busy = true;
        try
        {
            var request = new CreateOrderRequest(
                customerName,
                CartState.Lines.Select(l => new CreateOrderLine(l.Product.Id, l.Quantity)).ToList());

            var (order, err) = await OrdersClient.CreateOrderAsync(request);
            if (order is null)
            {
                error = err;
                return;
            }

            createdOrder = order;
            CartState.Clear();
        }
        catch (HttpRequestException)
        {
            error = "Услугата за поръчки не е достъпна. Опитайте по-късно.";
        }
        finally
        {
            busy = false;
        }
    }
}