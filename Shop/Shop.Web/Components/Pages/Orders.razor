@page "/orders"
@inject OrdersApiClient OrdersClient
@implements IDisposable

<PageTitle>Поръчки</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Поръчки</MudText>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Обнови</MudButton>
</MudStack>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error">@error</MudAlert>
}
else if (orders is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (orders.Count == 0)
{
    <MudText>Още няма поръчки.</MudText>
}
else
{
    @foreach (var o in orders)
    {
        <MudCard Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Поръчка #@ShortId(o.Id)</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @o.CustomerName · @o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(o.Status)">@StatusText(o.Status)</MudChip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudProgressLinear Value="@StatusProgress(o.Status)" Color="@StatusColor(o.Status)" Rounded="true" Class="mb-3" />
                @foreach (var i in o.Items)
                {
                    <div class="d-flex justify-space-between py-1">
                        <span>@i.ProductName × @i.Quantity</span>
                        <span>@((i.UnitPrice * i.Quantity).ToString("N2")) €</span>
                    </div>
                }
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between">
                    <b>Общо</b>
                    <b>@o.Total.ToString("N2") €</b>
                </div>
            </MudCardContent>
        </MudCard>
    }
}

@code {
    private List<OrderDto>? orders;
    private string? error;

    private static string ShortId(string id) => id.Length > 6 ? id[^6..].ToUpperInvariant() : id;

    private static string StatusText(string status) => status switch
    {
        "New" => "Нова",
        "Confirmed" => "Потвърдена",
        "Shipped" => "Изпратена",
        "Cancelled" => "Отказана",
        _ => status
    };

    private static Color StatusColor(string status) => status switch
    {
        "New" => Color.Info,
        "Confirmed" => Color.Primary,
        "Shipped" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private CancellationTokenSource? cts;

private static double StatusProgress(string status) => status switch
{
    "New" => 33,
    "Confirmed" => 66,
    "Shipped" => 100,
    "Cancelled" => 100,
    _ => 0
};

protected override async Task OnInitializedAsync()
{
    await LoadAsync();
    cts = new CancellationTokenSource();
    _ = PollAsync(cts.Token);
}

private async Task PollAsync(CancellationToken ct)
{
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
    try
    {
        while (await timer.WaitForNextTickAsync(ct))
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
    }
    catch (OperationCanceledException)
    {
        // страницата е затворена
    }
}

public void Dispose()
{
    cts?.Cancel();
    cts?.Dispose();
}

    private async Task LoadAsync()
    {
        try
        {
            error = null;
            orders = await OrdersClient.GetOrdersAsync();
        }
        catch (HttpRequestException)
        {
            error = "Услугата за поръчки не е достъпна. Опитайте по-късно.";
        }
    }
}